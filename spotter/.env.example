# Public site configuration
NEXT_PUBLIC_SITE_URL=https://travelasambe.co.za
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Server-only secrets. Never expose these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=your-supabase-service-role-key
RESEND_API_KEY=re_your-server-api-key
ENQUIRY_NOTIFICATION_EMAIL=hello@example.com

# Configure Upstash Redis for enquiry rate limiting.
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token